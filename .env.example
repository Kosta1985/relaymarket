PORT=8787
RELAYMARKET_DATA_FILE=./data/market.json
# Production target only; current MVP does not connect to PostgreSQL yet.
DATABASE_URL=postgres://user:password@localhost:5432/relaymarket

# Payment provider: mock for local development only; production defaults to disabled.
RELAYMARKET_PAYMENT_PROVIDER=mock
# Future production Stripe secrets must never be committed.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Production economics/legal gate. Choose deliberately before enabling Stripe:
# platform_absorbs | provider_external_costs | payer_surcharge_compliant
PAYMENT_PROCESSOR_COST_POLICY=unset

# Australian operator verification (production secrets; never commit real values)
# ABR_GUID=...                  # Free ABN Lookup web-services GUID from abr.business.gov.au
# TRUST_ADMIN_TOKEN=...         # High-entropy secret for internal trust/sanctions review endpoint

# Optional extra browser origins allowed to call the production API.
# Leave unset for same-origin portal access only. Comma-separated HTTPS origins.
# BROWSER_CORS_ORIGINS=https://admin.example.com
