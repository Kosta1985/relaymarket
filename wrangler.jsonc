{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relaymarket",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "vars": { "PAYMENT_PROVIDER": "disabled", "PAYMENT_PROCESSOR_COST_POLICY": "unset" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/health", "/mcp", "/a2a", "/.well-known/*", "/openapi.json", "/server.json", "/robots.txt", "/sitemap.xml", "/llms.txt", "/llms-full.txt", "/manifest.webmanifest"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relaymarket",
      "database_id": "44c4f48a-62ce-433f-b5e5-086382215f49",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "91734021",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
